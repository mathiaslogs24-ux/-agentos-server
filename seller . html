function renderWithdrawals(){
  document.getElementById('wdBalance').textContent = parseFloat(seller.balance||0).toFixed(2)+'€';
  document.getElementById('wdAmount').max = seller.balance||0;

  const withdrawals = seller.withdrawals||[];
  const el = document.getElementById('withdrawalsList');
  if(!withdrawals.length){
    el.innerHTML=`<div class="empty-state"><div class="empty-icon">💸</div><div class="empty-title">Aucun retrait</div><div class="empty-sub">Vos demandes apparaîtront ici</div></div>`;
    return;
  }
  el.innerHTML = withdrawals.map(wd=>`<div class="wd-card">
    <div class="wd-amount">${wd.amount}€</div>
    <div class="wd-info">
      <div>${wd.coords?.slice(0,40)||'—'}…</div>
      <div class="wd-date">📅 ${wd.date}</div>
    </div>
    <span class="tag ${wd.status==='paid'?'ok':'pending'}">${wd.status==='paid'?'✓ Payé':'⏳ En attente'}</span>
  </div>`).join('');
}

async function requestWithdrawal(){
  const amount = parseFloat(document.getElementById('wdAmount').value);
  const coords = document.getElementById('wdCoords').value.trim();
  if(!amount||amount<=0){ showToast('⚠ Montant invalide','err'); return; }
  if(amount>(seller.balance||0)){ showToast('⚠ Solde insuffisant','err'); return; }
  if(!coords){ showToast('⚠ Coordonnées requises','err'); return; }
  try {
    const res = await api('POST','/seller/withdrawal', {amount,coords});
    seller = {...seller, ...res.seller};
    renderWithdrawals();
    document.getElementById('wdAmount').value='';
    document.getElementById('wdCoords').value='';
    updateGlobalStats();
    showToast('✓ Demande de retrait envoyée');
  } catch(e){ showToast('⚠ '+e.message,'err'); }
}

