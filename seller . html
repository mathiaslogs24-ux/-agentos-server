<div class="toast" id="toast"></div>

<script>
'use strict';

// ═══════════════════════════════════════════════════
//  CONFIG
// ═══════════════════════════════════════════════════
const SERVER = location.origin; // même domaine — pas de problème CORS

// ═══════════════════════════════════════════════════
//  STATE
// ═══════════════════════════════════════════════════
let secret      = '';
let seller      = null;
let stock       = [];
let orders      = [];
let promos      = [];
let nid         = 1;
let currentPeriod = '7d';
let catFilterBrand = 'all';
let catFilterPuffs = 'all';
let chartRevenue   = null;
let chartOrders2   = null;

// ═══════════════════════════════════════════════════
//  UTILS
// ═══════════════════════════════════════════════════
function fmtPuffs(p){ return p>=1000?(p/1000).toFixed(0)+'K':String(p); }
function extractBrand(cat){ return (cat||'').trim().split(' ')[0]||''; }
function puffsKey(p){ return p?fmtPuffs(p):''; }
function getEmoji(name=''){
  const n=name.toLowerCase();
  if(n.includes('blue')||n.includes('myrt')||n.includes('blueberry')) return '🫐';
  if(n.includes('cherry')||n.includes('cerise')) return '🍒';
  if(n.includes('strawberry')||n.includes('fraise')) return '🍓';
  if(n.includes('mango')||n.includes('mangue')) return '🥭';
  if(n.includes('watermelon')||n.includes('past')) return '🍉';
  if(n.includes('passion')||n.includes('kiwi')) return '🥝';
  if(n.includes('raspberry')||n.includes('framb')) return '🍇';
  if(n.includes('peach')||n.includes('p\xeache')) return '🍑';
  if(n.includes('lemon')||n.includes('citron')) return '🍋';
  if(n.includes('skittles')||n.includes('mixed')||n.includes('candy')||n.includes('berry')) return '🍬';
  if(n.includes('mint')||n.includes('menthe')||n.includes('ice')) return '❄️';
  if(n.includes('tobacco')||n.includes('tabac')) return '🍂';
  return '💨';
}

let toastTimer;
function showToast(msg, type='ok'){
  const el=document.getElementById('toast');
  el.textContent=msg; el.className='toast '+type+' show';
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>el.classList.remove('show'),3000);
}

async function api(method, path, body){
  const opts = { method, headers:{'x-secret':secret,'Content-Type':'application/json'} };
  if(body!==undefined) opts.body=JSON.stringify(body);
  const r = await fetch(SERVER+path, opts);
  const data = await r.json();
  if(!r.ok) throw new Error(data.error||'Erreur '+r.status);
  return data;
}

// ═══════════════════════════════════════════════════
//  AUTH
// ═══════════════════════════════════════════════════
document.getElementById('secretInput').addEventListener('keydown', e=>{ if(e.key==='Enter') doLogin(); });

async function doLogin(){
  const s = document.getElementById('secretInput').value.trim();
  const btn = document.getElementById('loginBtn');
  const err = document.getElementById('loginErr');
  if(!s){ err.textContent='Veuillez entrer votre clé secrète.'; err.style.display='block'; return; }
  btn.disabled=true; btn.textContent='Connexion…';
  err.style.display='none';
  try {
    const r = await fetch(SERVER+'/seller/me', { headers:{'x-secret':s,'Content-Type':'application/json'} });
    if(!r.ok){
      const d = await r.json().catch(()=>({}));
      throw new Error(d.error||'Clé incorrecte (erreur '+r.status+')');
    }
    seller = await r.json();
    secret = s;
    stock  = seller.stock || [];
    promos = seller.promos || [];
    nid    = stock.length ? Math.max(...stock.map(x=>x.id||0))+1 : 1;
    // Boot dashboard
    document.getElementById('loginView').style.display='none';
    const dv = document.getElementById('dashView');
    dv.style.display='flex';
    document.getElementById('sellerAv').textContent = (seller.shopName||seller.name||'?')[0].toUpperCase();
    document.getElementById('sellerNm').textContent = seller.shopName||seller.name;
    updateGlobalStats();
    renderStockPanel();
    renderCatalogue();
  } catch(e) {
    err.textContent = '⚠ '+e.message;
    err.style.display = 'block';
  } finally {
    btn.disabled=false; btn.textContent='Accéder à mon dashboard →';
  }
}

function doLogout(){
  secret=''; seller=null; stock=[]; promos=[]; orders=[];
  document.getElementById('loginView').style.display='flex';
  document.getElementById('dashView').style.display='none';
  document.getElementById('secretInput').value='';
  document.getElementById('loginErr').style.display='none';
  // Reset charts
  if(chartRevenue){ chartRevenue.destroy(); chartRevenue=null; }
  if(chartOrders2){ chartOrders2.destroy(); chartOrders2=null; }
}

// ═══════════════════════════════════════════════════
//  TABS
// ═══════════════════════════════════════════════════
function switchTab(tab){
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tnav').forEach(n=>n.classList.remove('active'));
  document.getElementById('panel-'+tab).classList.add('active');
  document.getElementById('nav-'+tab).classList.add('active');
  // Actions par tab
  if(tab==='catalogue') renderCatalogue();
  if(tab==='orders')    loadOrders();
  if(tab==='stats')     loadStats();
  if(tab==='promos')    renderPromos();
  if(tab==='withdrawals') renderWithdrawals();
}

// ═══════════════════════════════════════════════════
//  STATS RAPIDES
// ═══════════════════════════════════════════════════
function updateGlobalStats(){
  const val    = stock.reduce((s,x)=>s+(x.qty||0)*(x.price||0), 0);
  const active = stock.filter(x=>x.enVente&&x.qty>0).length;
  document.getElementById('stBal').textContent    = parseFloat(seller.balance||0).toFixed(2)+'€';
  document.getElementById('stSales').textContent  = parseFloat(seller.totalSales||0).toFixed(2)+'€';
  document.getElementById('stVal').textContent    = val.toFixed(2)+'€';
  document.getElementById('stActive').textContent = active;
  document.getElementById('stockCountBadge').textContent = stock.length+' article'+(stock.length!==1?'s':'');
  document.getElementById('catActiveBadge').textContent  = active+' en vente';
}

// ═══════════════════════════════════════════════════
//  PANEL STOCK
// ═══════════════════════════════════════════════════
function renderStockPanel(){
  updateGlobalStats();
  const body = document.getElementById('stockBody');
  if(!stock.length){
    body.innerHTML=`<tr><td colspan="8" style="text-align:center;color:var(--t3);padding:32px;">
      Aucun article — cliquez sur "+ Ajouter"</td></tr>`;
    return;
  }
  body.innerHTML = stock.map((s,i)=>{
    const imgHTML = s.image
      ? `<img class="img-thumb" src="${s.image}" onclick="pickImg(${i})" onerror="this.style.display='none'">`
      : `<div class="img-pick" onclick="pickImg(${i})">📷</div>`;
    return `<tr>
      <td>
        ${imgHTML}
        <input type="file" id="imgInput_${i}" accept="image/*" style="display:none" onchange="loadImg(${i},this)">
        ${s.image?`<div style="font-size:9px;color:var(--red);cursor:pointer;margin-top:3px;text-align:center;" onclick="stock[${i}].image='';renderStockPanel()">✕ Suppr.</div>`:''}
      </td>
      <td><input class="fi wide" value="${s.name||''}" oninput="stock[${i}].name=this.value;updateGlobalStats()"></td>
      <td><input class="fi cat" value="${s.cat||''}" oninput="stock[${i}].cat=this.value"></td>
      <td><input class="fi num" type="number" min="0" value="${s.qty||0}" oninput="stock[${i}].qty=parseInt(this.value)||0;updateGlobalStats()"></td>
      <td><input class="fi pr" type="number" step="0.01" value="${s.price||0}" oninput="stock[${i}].price=parseFloat(this.value)||0;updateGlobalStats()"></td>
      <td style="display:flex;align-items:center;gap:4px;">
        <input class="fi pf" type="number" placeholder="18" value="${s.puffs?s.puffs/1000:''}" oninput="stock[${i}].puffs=(parseFloat(this.value)||0)*1000">
        <span style="font-size:10px;color:var(--t3);">K</span>
      </td>
      <td><input class="fi" type="number" style="width:60px;" value="${s.alert||5}" oninput="stock[${i}].alert=parseInt(this.value)||5"></td>
      <td><button class="btn xs danger" onclick="delStock(${i})">✕</button></td>
    </tr>`;
  }).join('');
}

function addStockRow(){
  stock.push({id:nid++, name:'', cat:'', qty:0, price:0, puffs:0, alert:5, enVente:false, image:''});
  renderStockPanel();
  // Scroll au dernier
  const last = document.getElementById('stockBody').lastElementChild;
  if(last) last.scrollIntoView({behavior:'smooth', block:'nearest'});
}

function delStock(i){
  stock.splice(i,1);
  renderStockPanel();
  renderCatalogue();
}

function pickImg(i){ document.getElementById('imgInput_'+i)?.click(); }
function loadImg(i, input){
  const file=input.files[0]; if(!file) return;
  const reader=new FileReader();
  reader.onload=e=>{
    const img=new Image();
    img.onload=()=>{
      const max=600, canvas=document.createElement('canvas');
      let w=img.width, h=img.height;
      if(w>max){h=Math.round(h*max/w);w=max;}
      if(h>max){w=Math.round(w*max/h);h=max;}
      canvas.width=w; canvas.height=h;
      canvas.getContext('2d').drawImage(img,0,0,w,h);
      stock[i].image = canvas.toDataURL('image/jpeg',0.8);
      renderStockPanel();
      showToast('✓ Image ajoutée');
    };
    img.src=e.target.result;
  };
  reader.readAsDataURL(file);
}

async function pushStock(){
  try {
    await api('POST','/seller/stock', stock);
    seller.stock = stock;
    showToast('✓ Stock sauvegardé et poussé');
  } catch(e){ showToast('⚠ '+e.message,'err'); }
}

// ═══════════════════════════════════════════════════
//  PANEL CATALOGUE
// ═══════════════════════════════════════════════════
function buildCatFilters(){
  const brands  = [...new Set(stock.filter(s=>s.qty>0).map(s=>extractBrand(s.cat)).filter(Boolean))];
  const puffsVals = [...new Set(stock.filter(s=>s.qty>0&&s.puffs).map(s=>puffsKey(s.puffs)))].sort((a,b)=>parseInt(a)*1000-parseInt(b)*1000);

  document.getElementById('brandFilterChips').innerHTML =
    `<div class="filter-chip active" onclick="setCatFilter('brand','all',this)">Toutes</div>`
    + brands.map(b=>`<div class="filter-chip" onclick="setCatFilter('brand','${b}',this)">${b}</div>`).join('');

  document.getElementById('puffsFilterChips').innerHTML =
    `<div class="filter-chip active" onclick="setCatFilter('puffs','all',this)">Tous</div>`
    + puffsVals.map(v=>`<div class="filter-chip" onclick="setCatFilter('puffs','${v}',this)">💨 ${v}</div>`).join('');
}

function setCatFilter(type, val, el){
  if(type==='brand'){ catFilterBrand=val; document.querySelectorAll('#brandFilterChips .filter-chip').forEach(c=>c.classList.remove('active','active-purple')); el.classList.add(val==='all'?'active':'active-purple'); }
  if(type==='puffs'){ catFilterPuffs=val; document.querySelectorAll('#puffsFilterChips .filter-chip').forEach(c=>c.classList.remove('active','active-blue')); el.classList.add(val==='all'?'active':'active-blue'); }
  renderCatalogue();
}

function renderCatalogue(){
  buildCatFilters();
  const minP = parseFloat(document.getElementById('catPriceMin')?.value)||0;
  const maxP = parseFloat(document.getElementById('catPriceMax')?.value)||Infinity;
  const sort  = document.getElementById('catSort')?.value||'';

  let items = stock.filter(s=>s.qty>0);
  if(catFilterBrand!=='all') items=items.filter(s=>extractBrand(s.cat)===catFilterBrand);
  if(catFilterPuffs!=='all') items=items.filter(s=>puffsKey(s.puffs)===catFilterPuffs);
  items=items.filter(s=>parseFloat(s.price||0)>=minP && parseFloat(s.price||0)<=maxP);
  if(sort==='price-asc')   items.sort((a,b)=>a.price-b.price);
  if(sort==='price-desc')  items.sort((a,b)=>b.price-a.price);
  if(sort==='name')        items.sort((a,b)=>a.name.localeCompare(b.name));
  if(sort==='stock-desc')  items.sort((a,b)=>b.qty-a.qty);

  const grid = document.getElementById('catGrid');
  if(!items.length){
    grid.innerHTML=`<div style="grid-column:1/-1;text-align:center;color:var(--t3);padding:32px;font-size:13px;">Aucun article correspond aux filtres</div>`;
    return;
  }

  const activeCount = stock.filter(s=>s.enVente&&s.qty>0).length;
  document.getElementById('catActiveBadge').textContent = activeCount+' en vente';

  grid.innerHTML = items.map(s=>{
    const idx = stock.indexOf(s);
    const brand = extractBrand(s.cat);
    const nicotine = (s.cat||'').replace(brand,'').trim();
    const ss = s.qty<=0?'out':s.qty<=(s.alert||5)?'low':'ok';
    const sl = s.qty<=0?'Rupture':s.qty<=(s.alert||5)?s.qty+' restants':s.qty+' dispo';
    const pf = s.puffs?fmtPuffs(s.puffs)+' puffs':'';
    const em = s.image?'':`<span class="emoji">${getEmoji(s.name)}</span>`;
    const imgEl = s.image?`<img src="${s.image}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" onerror="this.style.display='none'">${em}`:em;

    return `<div class="cat-card ${s.enVente?'active-card':''}">
      <div class="cat-card-img">
        ${imgEl}
        ${pf?`<div class="cat-card-puffs">${pf}</div>`:''}
        <div class="cat-card-stock ${ss}">${sl}</div>
      </div>
      <div class="cat-card-body">
        <div class="cat-card-brand">${brand}${nicotine?' · '+nicotine:''}</div>
        <div class="cat-card-name">${s.name||'Sans nom'}</div>
        <div class="cat-card-price">${parseFloat(s.price||0).toFixed(2)}€</div>
        <div class="cat-card-footer">
          <label class="sw" title="${s.enVente?'Désactiver':'Activer'}">
            <input type="checkbox" ${s.enVente?'checked':''} onchange="toggleEnVente(${idx},this.checked)">
            <span class="sw-t"></span><span class="sw-k"></span>
          </label>
          <span class="cat-card-sw-label" style="font-size:11px;color:${s.enVente?'var(--green)':'var(--t2)'};">${s.enVente?'En vente ✓':'Désactivé'}</span>
        </div>
      </div>
    </div>`;
  }).join('');
}

function toggleEnVente(i, val){
  stock[i].enVente = val;
  updateGlobalStats();
  renderCatalogue();
}
function catSelectAll(val){
  stock.forEach(s=>{ if(s.qty>0) s.enVente=val; });
  renderCatalogue();
}

async function pushCatalogue(){
  // 1. Sauvegarder le stock d'abord
  try { await api('POST','/seller/stock', stock); }
  catch(e){ showToast('⚠ Erreur stock: '+e.message,'err'); return; }

  // 2. Construire et pousser les shopItems
  const shopItems = stock.filter(s=>s.enVente&&s.qty>0).map(s=>({
    title      : s.name,
    image      : s.image||'',
    description: s.puffs ? fmtPuffs(s.puffs)+' puffs'+(s.cat?' · '+s.cat:'') : (s.cat||''),
    price      : String(s.price||0),
    asset      : 'EUR',
    payload    : 'stock_'+s.id,
    stockId    : s.id,
  }));

  try {
    await api('POST','/seller/shop', shopItems);
    seller.stock = stock;
    showToast(`✓ Catalogue poussé · ${shopItems.length} article${shopItems.length!==1?'s':''} en vente`);
  } catch(e){ showToast('⚠ '+e.message,'err'); }
}

