//  CATALOGUE
// ═══════════════════════════════════════════════════
function buildCatFilters(){
  const brands    = [...new Set(stock.filter(s=>s.qty>0).map(s=>extractBrand(s.cat)).filter(Boolean))];
  const puffsVals = [...new Set(stock.filter(s=>s.qty>0&&s.puffs).map(s=>puffsKey(s.puffs)))].sort((a,b)=>parseInt(a)*1000-parseInt(b)*1000);

  document.getElementById('brandFilterChips').innerHTML =
    `<div class="fchip ${catFilterBrand==='all'?'active':''}" onclick="setCatFilter('brand','all',this)">Toutes</div>`
    + brands.map(b=>`<div class="fchip ${catFilterBrand===b?'ap':''}" onclick="setCatFilter('brand','${b}',this)">${b}</div>`).join('');

  document.getElementById('puffsFilterChips').innerHTML =
    `<div class="fchip ${catFilterPuffs==='all'?'active':''}" onclick="setCatFilter('puffs','all',this)">Tous</div>`
    + puffsVals.map(v=>`<div class="fchip ${catFilterPuffs===v?'ab':''}" onclick="setCatFilter('puffs','${v}',this)">💨 ${v}</div>`).join('');
}

function setCatFilter(type, val, el){
  if(type==='brand') catFilterBrand=val;
  if(type==='puffs') catFilterPuffs=val;
  buildCatFilters();
  renderCatalogue();
}

function clearCatFilters(){
  catFilterBrand='all'; catFilterPuffs='all';
  document.getElementById('catPriceMin').value='';
  document.getElementById('catPriceMax').value='';
  document.getElementById('catSort').value='';
  buildCatFilters(); renderCatalogue();
}

function renderCatalogue(){
  buildCatFilters();
  const minP = parseFloat(document.getElementById('catPriceMin')?.value)||0;
  const maxP = parseFloat(document.getElementById('catPriceMax')?.value)||Infinity;
  const sort = document.getElementById('catSort')?.value||'';

  let items = stock.filter(s=>s.qty>0);
  if(catFilterBrand!=='all') items=items.filter(s=>extractBrand(s.cat)===catFilterBrand);
  if(catFilterPuffs!=='all') items=items.filter(s=>puffsKey(s.puffs)===catFilterPuffs);
  items=items.filter(s=>parseFloat(s.price||0)>=minP && parseFloat(s.price||0)<=maxP);
  if(sort==='price_asc')  items=[...items].sort((a,b)=>a.price-b.price);
  if(sort==='price_desc') items=[...items].sort((a,b)=>b.price-a.price);
  if(sort==='name_asc')   items=[...items].sort((a,b)=>(a.name||'').localeCompare(b.name||''));

  const active = stock.filter(s=>s.enVente&&s.qty>0).length;
  document.getElementById('catActiveBadge').textContent = active+' en vente';

  const grid = document.getElementById('catGrid');
  if(!items.length){
    grid.innerHTML='<div class="empty-state" style="grid-column:1/-1;"><div class="empty-icon">🔍</div><div class="empty-title">Aucun goût correspondant</div></div>';
    return;
  }

  grid.innerHTML = items.map(s=>{
    const idx   = stock.indexOf(s);
    const brand = extractBrand(s.cat);
    const pf    = s.puffs ? fmtPuffs(s.puffs)+' puffs' : '';
    return `<div class="cat-card ${s.enVente?'on':''}">
      <div class="cat-card-img">
        ${s.image?`<img src="${s.image}" alt="${s.name}">`:`<span style="font-size:32px;">${emoji(s.name)}</span>`}
      </div>
      <div class="cat-card-brand">${brand}${s.taux?' · '+s.taux:''}</div>
      <div class="cat-card-name">${s.name||'Sans nom'}</div>
      <div class="cat-card-meta">${[pf, s.qty+' en stock'].filter(Boolean).join(' · ')}</div>
      <div class="cat-card-price">${parseFloat(s.price||0).toFixed(2)}€</div>
      <div class="cat-card-toggle">
        <label class="sw">
          <input type="checkbox" ${s.enVente?'checked':''} onchange="stock[${idx}].enVente=this.checked;renderCatalogue()">
          <span class="sw-t"></span><span class="sw-k"></span>
        </label>
        <span style="color:${s.enVente?'var(--green)':'var(--t2)'};">${s.enVente?'En vente ✓':'Désactivé'}</span>
      </div>
    </div>`;
  }).join('');
}

function catSelectAll(state){ stock.forEach(s=>{if(s.qty>0)s.enVente=state;}); renderCatalogue(); }

async function pushCatalogue(){
  const items = stock.filter(s=>s.enVente&&s.qty>0).map(s=>({
    title      : s.name,
    image      : s.image||'',
    description: s.puffs ? fmtPuffs(s.puffs)+' puffs'+(s.cat?' · '+s.cat:'') : (s.cat||''),
    price      : String(s.price||0),
    asset      : 'EUR',
    payload    : 'stock_'+s.id,
    stockId    : s.id,
    cat        : (s.cat||'')+(s.taux?' '+s.taux:''),
  }));
  try {
    await api('POST','/seller/shop', items);
    showToast('✓ Catalogue poussé · '+items.length+' goût(s) en vente');
  } catch(e){ showToast('⚠ '+e.message,'err'); }
}

// ─── pushAll = stock + catalogue en une fois
async function pushAll(){
  await pushStock();
  await pushCatalogue();
}


