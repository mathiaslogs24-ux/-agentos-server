//  STOCK — variables bulk
// ═══════════════════════════════════════════════════
let vBulkSelected = new Set();

function stockSt(q,a){
  if(q===0)      return['Rupture','tr2'];
  if(q<=(a||5))  return['Stock bas','ta'];
  return['Dispo','tg'];
}

function updateStockStats(){
  const total  = stock.length;
  const val    = stock.reduce((s,x)=>s+(x.qty||0)*(x.price||0),0);
  const alerts = stock.filter(x=>x.qty>0&&x.qty<=(x.alert||5)).length;
  const active = stock.filter(x=>x.enVente&&x.qty>0).length;
  document.getElementById('vStCount').textContent  = total;
  document.getElementById('vStAlerts').textContent = alerts;
  document.getElementById('vStVal').textContent    = val.toFixed(2)+'€';
  document.getElementById('catActiveBadge').textContent = active+' en vente';
  // Stats sidebar
  if(document.getElementById('stVal'))    document.getElementById('stVal').textContent    = val.toFixed(2)+'€';
  if(document.getElementById('stActive')) document.getElementById('stActive').textContent = active;
}

function renderStock(){
  updateStockStats();
  const q = (document.getElementById('vStockSearch')?.value||'').toLowerCase();
  const body = document.getElementById('stockBody');
  const items = q ? stock.filter(s=>(s.name||'').toLowerCase().includes(q)||(s.cat||'').toLowerCase().includes(q)||(s.taux||'').toLowerCase().includes(q)) : stock;

  if(!items.length){
    body.innerHTML=`<tr><td colspan="11" style="text-align:center;color:var(--t3);padding:32px;">Aucun article — cliquez sur "+ Ajouter"</td></tr>`;
    return;
  }

  body.innerHTML = items.map((s,i)=>{
    const idx      = stock.indexOf(s);
    const isChk    = vBulkSelected.has(s.id);
    const [lbl,tc] = stockSt(s.qty,s.alert||5);
    const imgHTML  = s.image
      ? `<img src="${s.image}" style="width:42px;height:42px;border-radius:8px;object-fit:cover;border:1px solid var(--gb);cursor:pointer;" onclick="pickImg(${i})" onerror="this.style.display='none'">`
      : `<div onclick="pickImg(${i})" style="width:42px;height:42px;border-radius:8px;background:var(--bg3);border:2px dashed var(--gb);display:flex;align-items:center;justify-content:center;font-size:18px;cursor:pointer;">${emoji(s.name)}</div>`;

    return `<tr id="vrow_${s.id}" style="${isChk?'background:rgba(240,180,41,.05)':''}">
      <td style="padding:8px;text-align:center;">
        <label class="sw" style="display:inline-block;width:32px;height:18px;">
          <input type="checkbox" ${isChk?'checked':''} onchange="vToggleRow(${s.id},this.checked)">
          <span class="sw-t"></span><span class="sw-k"></span>
        </label>
      </td>
      <td style="width:60px;">
        ${imgHTML}
        <input type="file" id="imgInput_${i}" accept="image/*" style="display:none" onchange="loadImg(${i},this)">
        ${s.image?`<div style="font-size:9px;color:var(--red);cursor:pointer;margin-top:2px;text-align:center;" onclick="stock[${idx}].image='';renderStock()">✕</div>`:''}
      </td>
      <td><input class="fi wide" value="${s.name||''}" oninput="stock[${idx}].name=this.value;updateStockStats()" placeholder="ex: Blue Razz Ice"></td>
      <td><input class="fi cat" value="${s.cat||''}" oninput="stock[${idx}].cat=this.value" placeholder="ex: JNR" style="max-width:90px;"></td>
      <td><input class="fi cat" value="${s.taux||''}" oninput="stock[${idx}].taux=this.value" placeholder="ex: 2%" style="max-width:70px;"></td>
      <td>
        <div style="display:flex;align-items:center;gap:5px;">
          <button class="btn bsm" onclick="chQty(${idx},-1)" style="width:24px;padding:3px;font-size:12px;">−</button>
          <input class="fi num" type="number" min="0" value="${s.qty||0}" oninput="stock[${idx}].qty=parseInt(this.value)||0;updateStockStats()">
          <button class="btn bsm" onclick="chQty(${idx},1)" style="width:24px;padding:3px;font-size:12px;">+</button>
        </div>
      </td>
      <td><input class="fi pr" type="number" step="0.01" value="${s.price||0}" oninput="stock[${idx}].price=parseFloat(this.value)||0;updateStockStats()"></td>
      <td>
        <div style="display:flex;align-items:center;gap:4px;">
          <input class="fi pf" type="number" placeholder="18" value="${s.puffs?s.puffs/1000:''}" oninput="stock[${idx}].puffs=(parseFloat(this.value)||0)*1000">
          <span style="font-size:10px;color:var(--t3);">K</span>
        </div>
      </td>
      <td><input class="fi" type="number" style="width:56px;" value="${s.alert||5}" oninput="stock[${idx}].alert=parseInt(this.value)||5"></td>
      <td><span class="tag ${tc}">${lbl}</span></td>
      <td><button class="btn bsm bd" onclick="delStock(${idx})">✕</button></td>
    </tr>`;
  }).join('');
}

// Alias pour compat
function renderStockPanel(){ renderStock(); }

function chQty(idx, d){ stock[idx].qty = Math.max(0,(stock[idx].qty||0)+d); renderStock(); }

function addStockRow(){
  stock.push({id:nid++, name:'', cat:'', taux:'', qty:0, price:0, puffs:0, alert:5, enVente:false, image:''});
  renderStock();
  const last = document.getElementById('stockBody').lastElementChild;
  if(last) last.scrollIntoView({behavior:'smooth',block:'nearest'});
}

function delStock(idx){ stock.splice(idx,1); renderStock(); renderCatalogue(); }

function vSaveLocal(){ showToast('✓ Modifications sauvegardées localement'); }

// ── Bulk edit
function vToggleRow(id, checked){
  if(checked) vBulkSelected.add(id); else vBulkSelected.delete(id);
  const row = document.getElementById('vrow_'+id);
  if(row) row.style.background = checked?'rgba(240,180,41,.05)':'';
  vUpdateBulkBar();
}

function vSelectAll(checked){
  stock.forEach(s=>{ if(checked) vBulkSelected.add(s.id); else vBulkSelected.delete(s.id); });
  renderStock();
  document.getElementById('vChkAll').checked = checked;
  vUpdateBulkBar();
}

function vDeselectAll(){
  vBulkSelected.clear();
  renderStock();
  document.getElementById('vChkAll').checked = false;
  vUpdateBulkBar();
}

function vUpdateBulkBar(){
  const n = vBulkSelected.size;
  document.getElementById('vBulkBar').style.display = n>0?'block':'none';
  document.getElementById('vBulkCount').textContent = n+' sélectionné(s)';
}

function vBulkApply(field){
  const ids = [...vBulkSelected];
  if(!ids.length) return;
  ids.forEach(id=>{
    const s = stock.find(x=>x.id===id); if(!s) return;
    if(field==='cat')   { s.cat   = document.getElementById('vBulkCat').value;  }
    if(field==='price') { s.price = parseFloat(document.getElementById('vBulkPrice').value)||0; }
    if(field==='puffs') { s.puffs = (parseFloat(document.getElementById('vBulkPuffs').value)||0)*1000; }
    if(field==='alert') { s.alert = parseInt(document.getElementById('vBulkAlert').value)||5; }
    if(field==='qty')   {
      const mode = document.getElementById('vBulkQtyMode').value;
      const val  = parseInt(document.getElementById('vBulkQty').value)||0;
      if(mode==='set') s.qty = val;
      if(mode==='add') s.qty = Math.max(0,(s.qty||0)+val);
      if(mode==='sub') s.qty = Math.max(0,(s.qty||0)-val);
    }
  });
  renderStock();
  showToast(`✓ ${field} mis à jour sur ${ids.length} article(s)`);
}

function vBulkDelete(){
  if(!confirm(`Supprimer ${vBulkSelected.size} article(s) ?`)) return;
  stock = stock.filter(s=>!vBulkSelected.has(s.id));
  vBulkSelected.clear();
  renderStock();
  renderCatalogue();
  vUpdateBulkBar();
}

