async function shipOrder(orderId, btn){
  btn.disabled=true; btn.textContent='⏳…';
  try {
    await api('POST','/seller/orders/'+orderId+'/ship');
    // Mettre à jour localement
    const o = orders.find(x=>String(x.id)===String(orderId));
    if(o) o.status='shipped';
    renderOrders();
    showToast('✓ Commande marquée expédiée — client notifié');
  } catch(e){ showToast('⚠ '+e.message,'err'); btn.disabled=false; btn.textContent='📦 Marquer expédiée'; }
}

// ═══════════════════════════════════════════════════
//  PANEL STATS
// ═══════════════════════════════════════════════════
const CHART_COLORS = {
  gold: 'rgba(240,180,41,1)', goldFill: 'rgba(240,180,41,0.15)',
  blue: 'rgba(79,195,247,1)', blueFill: 'rgba(79,195,247,0.12)',
};

function setPeriod(p, el){
  currentPeriod=p;
  document.querySelectorAll('.period-btn').forEach(b=>b.classList.remove('active'));
  el.classList.add('active');
  loadStats();
}

async function loadStats(){
  try {
    if(!orders.length) orders = await api('GET','/seller/orders');
    buildCharts();
    buildTopProducts();
    buildComparison();
  } catch(e){ showToast('⚠ '+e.message,'err'); }
}

function getDaysRange(period){
  const now = new Date();
  const days = [];
  let n = period==='7d'?7:period==='30d'?30:30;
  for(let i=n-1;i>=0;i--){
    const d=new Date(now); d.setDate(d.getDate()-i);
    days.push(d.toISOString().slice(0,10));
  }
  return days;
}

function getOrdersData(period){
  const days = getDaysRange(period);
  const revenueMap={}, ordersMap={};
  days.forEach(d=>{ revenueMap[d]=0; ordersMap[d]=0; });
  orders.forEach(o=>{
    const date = new Date(o.date.split('/').reverse().join('-')||o.id).toISOString().slice(0,10);
    if(revenueMap[date]!==undefined){
      revenueMap[date]+=parseFloat(o.net||0);
      ordersMap[date]+=1;
    }
  });
  return { labels:days.map(d=>d.slice(5)), revenue:days.map(d=>revenueMap[d]), count:days.map(d=>ordersMap[d]) };
}

function buildCharts(){
  const data = getOrdersData(currentPeriod);

  // Détruire anciens charts
  if(chartRevenue){ chartRevenue.destroy(); chartRevenue=null; }
  if(chartOrders2){ chartOrders2.destroy(); chartOrders2=null; }

  const revenueCtx = document.getElementById('chartRevenue').getContext('2d');
  chartRevenue = new Chart(revenueCtx,{
    type:'bar',
    data:{ labels:data.labels, datasets:[{ label:'Gain net (€)', data:data.revenue,
      backgroundColor:CHART_COLORS.goldFill, borderColor:CHART_COLORS.gold, borderWidth:2, borderRadius:4 }] },
    options:{ responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{display:false} },
      scales:{ x:{grid:{color:'rgba(255,255,255,.04)'}, ticks:{color:'#5A5752',font:{size:10}}},
                y:{grid:{color:'rgba(255,255,255,.04)'}, ticks:{color:'#5A5752',font:{size:10}}} } }
  });

  const ordersCtx = document.getElementById('chartOrders').getContext('2d');
  chartOrders2 = new Chart(ordersCtx,{
    type:'line',
    data:{ labels:data.labels, datasets:[{ label:'Ventes', data:data.count,
      borderColor:CHART_COLORS.blue, backgroundColor:CHART_COLORS.blueFill,
      fill:true, tension:0.4, pointBackgroundColor:CHART_COLORS.blue, pointRadius:3 }] },
    options:{ responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{display:false} },
      scales:{ x:{grid:{color:'rgba(255,255,255,.04)'}, ticks:{color:'#5A5752',font:{size:10}}},
                y:{grid:{color:'rgba(255,255,255,.04)'}, ticks:{color:'#5A5752',font:{size:10}},min:0,ticks:{stepSize:1}} } }
  });
}

function buildTopProducts(){
  const prodMap={};
  orders.forEach(o=>{
    (o.items||[]).forEach(item=>{
      const key=item.name||'Article #'+item.id;
      if(!prodMap[key]) prodMap[key]={name:key,qty:0,revenue:0};
      prodMap[key].qty+=parseInt(item.qty||1);
      prodMap[key].revenue+=parseFloat(o.net||0)/((o.items||[]).length||1);
    });
  });
  const top = Object.values(prodMap).sort((a,b)=>b.qty-a.qty).slice(0,5);
  const el = document.getElementById('topProductsTable');
  if(!top.length){ el.innerHTML=`<div style="text-align:center;color:var(--t3);padding:20px;font-size:12px;">Aucune vente pour cette période</div>`; return; }
  el.innerHTML=`<div class="tw"><table><thead><tr><th>Produit</th><th>Qté vendue</th><th>Gain net</th></tr></thead><tbody>`
    +top.map((p,i)=>`<tr><td><span style="color:var(--t3);margin-right:8px;">${['🥇','🥈','🥉','4️⃣','5️⃣'][i]}</span>${p.name}</td><td><span class="bx bl">${p.qty}</span></td><td style="color:var(--green);font-weight:700;">${p.revenue.toFixed(2)}€</td></tr>`).join('')
    +`</tbody></table></div>`;
}

function buildComparison(){
  const now = new Date();
  // Période actuelle
  const nDays = currentPeriod==='7d'?7:30;
  const curStart = new Date(now); curStart.setDate(curStart.getDate()-nDays);
  const prevStart = new Date(curStart); prevStart.setDate(prevStart.getDate()-nDays);

  let curRev=0,curCnt=0,prevRev=0,prevCnt=0;
  orders.forEach(o=>{
    const d = new Date(o.date?.split('/')?.[2]+'-'+o.date?.split('/')?.[1]+'-'+o.date?.split('/')?.[0] || 0);
    if(d>=curStart&&d<=now){  curRev+=parseFloat(o.net||0); curCnt++; }
    if(d>=prevStart&&d<curStart){ prevRev+=parseFloat(o.net||0); prevCnt++; }
  });

  const revDiff = curRev-prevRev;
  const cntDiff = curCnt-prevCnt;
  const revArrow = revDiff>=0?'▲':'▼';
  const cntArrow = cntDiff>=0?'▲':'▼';
  const revColor = revDiff>=0?'var(--green)':'var(--red)';
  const cntColor = cntDiff>=0?'var(--green)':'var(--red)';

  document.getElementById('comparisonSection').innerHTML=`
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <div>
        <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--t3);margin-bottom:6px;">Gain net — période actuelle</div>
        <div style="font-size:22px;font-weight:800;color:var(--gold);">${curRev.toFixed(2)}€</div>
        <div style="font-size:12px;color:${revColor};margin-top:4px;">${revArrow} ${Math.abs(revDiff).toFixed(2)}€ vs période précédente</div>
      </div>
      <div>
        <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--t3);margin-bottom:6px;">Nombre de ventes</div>
        <div style="font-size:22px;font-weight:800;">${curCnt}</div>
        <div style="font-size:12px;color:${cntColor};margin-top:4px;">${cntArrow} ${Math.abs(cntDiff)} vs période précédente</div>
      </div>
    </div>`;
}

// ═══════════════════════════════════════════════════
//  PANEL PROMOS
// ═══════════════════════════════════════════════════
function togglePromoLimit(){
  const v = document.getElementById('promoLimitType').value;
  document.getElementById('promoLimitValBox').style.display = v==='total'?'block':'none';
}
function togglePromoScope(){
  const v = document.getElementById('promoScope').value;
  document.getElementById('promoCatBox').style.display = v==='category'?'block':'none';
}

function createPromo(){
  const code  = document.getElementById('promoCode').value.trim().toUpperCase();
  const type  = document.getElementById('promoType').value;
  const value = parseFloat(document.getElementById('promoValue').value);
  const expiry = document.getElementById('promoExpiry').value;
  const limitType = document.getElementById('promoLimitType').value;
  const limitVal  = parseInt(document.getElementById('promoLimitVal').value)||null;
  const scope = document.getElementById('promoScope').value;
  const cat   = document.getElementById('promoCat').value.trim();

  if(!code){ showToast('⚠ Code obligatoire','err'); return; }
  if(!value||value<=0){ showToast('⚠ Valeur invalide','err'); return; }
  if(promos.find(p=>p.code===code)){ showToast('⚠ Ce code existe déjà','err'); return; }

  promos.push({
    id:Date.now(), code, type, value, expiry:expiry||null,
    limitType, limitVal, scope, cat:scope==='category'?cat:'',
    active:true, usedCount:0, usedBy:[],
    createdAt:new Date().toISOString(),
  });

  // Reset form
  ['promoCode','promoValue','promoExpiry','promoCat'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('promoLimitType').value='none';
  document.getElementById('promoLimitValBox').style.display='none';
  document.getElementById('promoScope').value='seller';
  document.getElementById('promoCatBox').style.display='none';

  renderPromos();
  showToast('✓ Code '+code+' créé');
}

function renderPromos(){
  document.getElementById('promosCount').textContent = promos.filter(p=>p.active).length;
  const el = document.getElementById('promosList');
  if(!promos.length){
    el.innerHTML=`<div class="empty-state"><div class="empty-icon">🏷</div><div class="empty-title">Aucun code promo</div><div class="empty-sub">Créez votre premier code</div></div>`;
    return;
  }
  el.innerHTML = promos.map((p,i)=>{
    const typeLabel = p.type==='percent'?`-${p.value}%`:`-${p.value}€`;
    const limitLabel = p.limitType==='none'?'Illimité':p.limitType==='per_user'?'1/client':`${p.usedCount}/${p.limitVal}`;
    const scopeLabel = p.scope==='category'?`Catégorie: ${p.cat}`:'Tous mes produits';
    const expLabel   = p.expiry?`Exp: ${p.expiry}`:'';
    return `<div class="promo-card">
      <div class="promo-code">${p.code}</div>
      <div class="promo-info">
        <div style="font-size:14px;font-weight:700;color:${p.active?'var(--text)':'var(--t3)'};">${typeLabel}</div>
        <div class="promo-desc">${scopeLabel}${expLabel?' · '+expLabel:''}</div>
        <div class="promo-uses">Utilisations: ${limitLabel}</div>
      </div>
      <div style="display:flex;gap:6px;align-items:center;">
        <label class="sw" title="${p.active?'Désactiver':'Activer'}">
          <input type="checkbox" ${p.active?'checked':''} onchange="promos[${i}].active=this.checked;renderPromos()">
          <span class="sw-t"></span><span class="sw-k"></span>
        </label>
        <button class="btn xs danger" onclick="promos.splice(${i},1);renderPromos()">✕</button>
      </div>
    </div>`;
  }).join('');
}

async function pushPromos(){
  try {
    await api('POST','/seller/promos', promos);
    seller.promos = promos;
    showToast('✓ Codes promo sauvegardés');
  } catch(e){ showToast('⚠ '+e.message,'err'); }
}

