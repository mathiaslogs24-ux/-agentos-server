function getSettings(){
  try { return JSON.parse(localStorage.getItem('vos_settings_'+(seller?.id||''))||'{}'); } catch(e){ return {}; }
}

function saveSettings(){
  const s = {
    alertsEnabled  : document.getElementById('settAlertsEnabled').checked,
    globalThreshold: parseInt(document.getElementById('settThreshold').value)||5,
    perItem        : getPerItemSettings(),
  };
  localStorage.setItem('vos_settings_'+(seller?.id||''), JSON.stringify(s));
  showToast('✓ Paramètres sauvegardés');
}

function getPerItemSettings(){
  const result = {};
  document.querySelectorAll('.per-item-input').forEach(input=>{
    const id = parseInt(input.dataset.id);
    const val = parseInt(input.value);
    if(val>0) result[id] = val;
  });
  return result;
}

function loadSettings(){
  const s = getSettings();
  document.getElementById('settAlertsEnabled').checked = s.alertsEnabled !== false;
  document.getElementById('settThreshold').value       = s.globalThreshold || 5;
  // Infos boutique
  if(document.getElementById('settShopName')) document.getElementById('settShopName').textContent = seller?.shopName||seller?.name||'—';
  if(document.getElementById('settSecretKey')) document.getElementById('settSecretKey').dataset.key = secret;
  renderPerItemThresholds(s.perItem||{});
}

function renderPerItemThresholds(perItem={}){
  const el = document.getElementById('perItemThresholds');
  if(!stock.length){
    el.innerHTML='<div style="color:var(--t3);font-size:12px;">Ajoutez des goûts dans le stock pour les configurer ici.</div>';
    return;
  }
  el.innerHTML = stock.map(s=>`
    <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:rgba(255,255,255,.02);border:1px solid var(--gb);border-radius:var(--rs);">
      <div>
        <div style="font-size:12px;font-weight:700;">${s.name||'Sans nom'}</div>
        <div style="font-size:10px;color:var(--t3);">${s.qty} en stock · seuil par défaut : 5</div>
      </div>
      <div style="display:flex;align-items:center;gap:8px;">
        <label class="sw" style="flex-shrink:0;">
          <input type="checkbox" class="per-item-notif" data-id="${s.id}" ${perItem[s.id]!==0?'checked':''} onchange="renderPerItemThresholds(getPerItemSettings())">
          <span class="sw-t"></span><span class="sw-k"></span>
        </label>
        <input type="number" class="per-item-input" data-id="${s.id}" min="1" max="100" placeholder="seuil"
          value="${perItem[s.id]||''}"
          style="width:65px;background:rgba(255,255,255,.05);border:1px solid var(--gb);color:var(--gold);font-family:'DM Mono';font-size:13px;font-weight:700;padding:5px 8px;border-radius:var(--rs);outline:none;text-align:center;"
          onfocus="this.style.borderColor='var(--gold)'" onblur="this.style.borderColor='var(--gb)';saveSettings()">
      </div>
    </div>`).join('');
}

function checkLocalAlerts(){
  const settings = getSettings();
  if(!settings.alertsEnabled) return;
  const threshold = settings.globalThreshold || 5;
  const low = stock.filter(s=>{
    const t = settings.perItem?.[s.id] || threshold;
    return s.qty>0 && s.qty<=t;
  });
  if(low.length){
    showToast(`⚠ ${low.length} goût(s) en stock bas !`,'err');
  }
}

