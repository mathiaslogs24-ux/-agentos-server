<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VendorOS</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@10..48,400;10..48,600;10..48,700;10..48,800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
/* ═══════════════════════════════════════
   VARIABLES
═══════════════════════════════════════ */
:root {
  --gold   : #F0B429;
  --gold2  : #FFD166;
  --gdim   : rgba(240,180,41,.08);
  --gborder: rgba(240,180,41,.25);
  --bg0    : #08080A;
  --bg1    : #0F0F12;
  --bg2    : #161619;
  --bg3    : #1E1E23;
  --bg4    : #26262D;
  --gb     : rgba(255,255,255,.07);
  --gb2    : rgba(255,255,255,.04);
  --text   : #F0EEE8;
  --t2     : #8A8680;
  --t3     : #4A4744;
  --green  : #4ADE80;
  --grdim  : rgba(74,222,128,.08);
  --grbdr  : rgba(74,222,128,.25);
  --red    : #F87171;
  --rdim   : rgba(248,113,113,.08);
  --rbdr   : rgba(248,113,113,.25);
  --blue   : #4FC3F7;
  --bdim   : rgba(79,195,247,.08);
  --bbdr   : rgba(79,195,247,.25);
  --purple : #C084FC;
  --pdim   : rgba(192,132,252,.08);
  --r      : 12px;
  --rs     : 8px;
  --rxs    : 5px;
}

/* ═══════════════════════════════════════
   RESET + BASE
═══════════════════════════════════════ */
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html, body { height:100%; background:var(--bg0); color:var(--text); font-family:'Bricolage Grotesque',sans-serif; overflow:hidden; }
button { font-family:inherit; cursor:pointer; }
input, textarea, select { font-family:inherit; }
a { color:inherit; text-decoration:none; }

/* ═══════════════════════════════════════
   LAYOUT
═══════════════════════════════════════ */
#app { height:100vh; display:flex; flex-direction:column; }

/* ─── LOGIN ─── */
#loginView {
  flex:1; display:flex; align-items:center; justify-content:center;
  background:radial-gradient(ellipse at 60% 40%, rgba(240,180,41,.04) 0%, transparent 70%);
}
.login-box {
  width:min(400px, 90vw);
  background:var(--bg2); border:1px solid var(--gb);
  border-radius:var(--r); padding:32px;
  box-shadow:0 24px 64px rgba(0,0,0,.4);
}
.login-logo { font-size:24px; font-weight:800; margin-bottom:6px; }
.login-logo span { color:var(--gold); }
.login-sub { font-size:13px; color:var(--t2); margin-bottom:28px; line-height:1.5; }
.login-label { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--t3); margin-bottom:6px; display:block; }
.login-input {
  width:100%; background:var(--bg3); border:1px solid var(--gb);
  color:var(--text); font-size:14px; padding:11px 14px;
  border-radius:var(--rs); outline:none; margin-bottom:16px;
  transition:border-color .15s;
}
.login-input:focus { border-color:var(--gold); }
.login-err { color:var(--red); font-size:12px; margin-top:10px; display:none; background:var(--rdim); border:1px solid var(--rbdr); padding:8px 12px; border-radius:var(--rxs); }

/* ─── TOPBAR ─── */
.topbar {
  flex-shrink:0; background:var(--bg1); border-bottom:1px solid var(--gb);
  height:52px; padding:0 20px; display:flex; align-items:center; gap:4px;
  position:relative; z-index:10;
}
.topbar-logo { font-size:16px; font-weight:800; margin-right:12px; white-space:nowrap; }
.topbar-logo span { color:var(--gold); }
.topbar-nav { display:flex; gap:2px; flex:1; overflow-x:auto; scrollbar-width:none; }
.topbar-nav::-webkit-scrollbar { display:none; }
.tnav {
  padding:6px 13px; border-radius:var(--rs); font-size:12px; font-weight:700;
  color:var(--t2); cursor:pointer; transition:all .15s; white-space:nowrap;
  display:flex; align-items:center; gap:5px;
}
.tnav:hover { color:var(--text); background:rgba(255,255,255,.03); }
.tnav.active { background:var(--gdim); color:var(--gold); }
.tnav .badge {
  background:var(--red); color:#fff; font-size:9px; font-weight:800;
  min-width:16px; height:16px; border-radius:8px; padding:0 4px;
  display:flex; align-items:center; justify-content:center;
}
.topbar-right { margin-left:auto; display:flex; align-items:center; gap:10px; flex-shrink:0; }
.seller-chip {
  display:flex; align-items:center; gap:8px;
  background:var(--bg3); border:1px solid var(--gb);
  border-radius:20px; padding:4px 12px 4px 4px;
}
.seller-av {
  width:26px; height:26px; border-radius:50%; background:var(--gold);
  display:flex; align-items:center; justify-content:center;
  font-size:12px; font-weight:800; color:#000; flex-shrink:0;
}
.seller-nm { font-size:12px; font-weight:700; }

/* ─── CONTENT ─── */
.app-body { flex:1; overflow:hidden; display:flex; }
.content { flex:1; overflow-y:auto; padding:20px; }
.content::-webkit-scrollbar { width:4px; }
.content::-webkit-scrollbar-thumb { background:var(--bg4); border-radius:2px; }

/* ─── PANELS ─── */
.panel { display:none; }
.panel.active { display:block; }

/* ═══════════════════════════════════════
   COMPOSANTS
═══════════════════════════════════════ */

/* Boutons */
.btn {
  padding:8px 14px; border-radius:var(--rs); font-size:12px; font-weight:700;
  border:1px solid var(--gb); background:var(--bg3); color:var(--text);
  transition:all .15s; display:inline-flex; align-items:center; gap:6px;
}
.btn:hover { border-color:rgba(255,255,255,.15); }
.btn:active { transform:scale(.97); }
.btn.primary { background:var(--gold); color:#000; border-color:var(--gold); }
.btn.primary:hover { background:var(--gold2); }
.btn.danger  { background:var(--rdim); color:var(--red); border-color:var(--rbdr); }
.btn.success { background:var(--grdim); color:var(--green); border-color:var(--grbdr); }
.btn.full    { width:100%; justify-content:center; padding:12px; }
.btn.sm      { padding:5px 10px; font-size:11px; }
.btn.xs      { padding:3px 8px; font-size:10px; }
.btn:disabled { opacity:.4; cursor:not-allowed; transform:none !important; }

/* Cards */
.card {
  background:var(--bg2); border:1px solid var(--gb);
  border-radius:var(--r); overflow:hidden; margin-bottom:14px;
}
.card-head {
  padding:12px 16px; border-bottom:1px solid var(--gb);
  display:flex; align-items:center; justify-content:space-between; gap:10px;
}
.card-title { font-size:13px; font-weight:700; display:flex; align-items:center; gap:8px; }
.card-actions { display:flex; gap:6px; flex-wrap:wrap; }
.card-body { padding:16px; }

/* Stats row */
.stats-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-bottom:18px; }
@media(max-width:800px) { .stats-grid { grid-template-columns:repeat(2,1fr); } }
.stat-card {
  background:var(--bg2); border:1px solid var(--gb);
  border-radius:var(--r); padding:14px 16px;
}
.stat-label { font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--t3); margin-bottom:8px; }
.stat-val { font-size:22px; font-weight:800; line-height:1; }
.stat-val.gold   { color:var(--gold); }
.stat-val.green  { color:var(--green); }
.stat-val.blue   { color:var(--blue); }
.stat-val.purple { color:var(--purple); }
.stat-sub { font-size:10px; color:var(--t3); margin-top:4px; }

/* Table */
.tw { overflow-x:auto; }
table { width:100%; border-collapse:collapse; }
th {
  text-align:left; font-size:9px; font-weight:700; text-transform:uppercase;
  letter-spacing:.08em; color:var(--t3); padding:9px 12px;
  border-bottom:1px solid var(--gb); white-space:nowrap;
}
td { padding:9px 12px; border-bottom:1px solid rgba(255,255,255,.03); font-size:13px; vertical-align:middle; }
tr:last-child td { border:none; }
tr:hover td { background:rgba(255,255,255,.01); }

/* Inputs dans table */
.fi {
  background:var(--bg3); border:1px solid var(--gb); color:var(--text);
  font-size:12px; padding:6px 10px; border-radius:var(--rxs);
  outline:none; width:100%; transition:border-color .15s;
}
.fi:focus { border-color:var(--gold); }
.fi.num  { font-family:'DM Mono'; font-size:14px; font-weight:700; color:var(--gold); text-align:center; width:72px; }
.fi.pr   { font-family:'DM Mono'; font-size:12px; width:80px; }
.fi.pf   { font-family:'DM Mono'; font-size:12px; width:68px; }
.fi.cat  { max-width:120px; }
.fi.wide { min-width:200px; }

/* Toggle switch */
.sw { display:inline-block; position:relative; width:40px; height:22px; cursor:pointer; flex-shrink:0; }
.sw input { display:none; }
.sw-t { position:absolute; inset:0; background:var(--bg4); border-radius:11px; transition:.2s; border:1px solid var(--gb); }
.sw input:checked + .sw-t { background:var(--gold); border-color:var(--gold); }
.sw-k { position:absolute; top:3px; left:3px; width:16px; height:16px; background:#fff; border-radius:50%; transition:.2s; pointer-events:none; }
.sw input:checked ~ .sw-k { transform:translateX(18px); }

/* Badges */
.bx { display:inline-block; padding:2px 8px; border-radius:var(--rxs); font-size:10px; font-weight:700; font-family:'DM Mono'; }
.bx.bl { background:var(--bdim); color:var(--blue); }
.bx.gr { background:var(--grdim); color:var(--green); }
.bx.gd { background:var(--gdim); color:var(--gold); }
.bx.rd { background:var(--rdim); color:var(--red); }
.bx.pu { background:var(--pdim); color:var(--purple); }

/* Tags statut */
.tag { display:inline-block; padding:3px 8px; border-radius:var(--rxs); font-size:11px; font-weight:700; }
.tag.ok  { background:var(--grdim); color:var(--green); border:1px solid var(--grbdr); }
.tag.err { background:var(--rdim);  color:var(--red);   border:1px solid var(--rbdr);  }
.tag.warn { background:rgba(251,146,60,.1); color:#FB923C; border:1px solid rgba(251,146,60,.25); }
.tag.pending { background:var(--bdim); color:var(--blue); border:1px solid var(--bbdr); }

/* Alerte info */
.alert { padding:12px 14px; border-radius:var(--rs); font-size:12px; line-height:1.5; }
.alert.info { background:var(--bdim); border:1px solid var(--bbdr); color:var(--blue); }
.alert.warn { background:rgba(251,146,60,.08); border:1px solid rgba(251,146,60,.25); color:#FB923C; }
.alert.gold { background:var(--gdim); border:1px solid var(--gborder); color:var(--gold); }

/* Catalogue — filtres */
.cat-filters {
  display:flex; gap:8px; flex-wrap:wrap; align-items:center;
  padding:12px 16px; border-bottom:1px solid var(--gb); background:var(--bg3);
}
.filter-chip {
  padding:5px 12px; border-radius:18px; font-size:11px; font-weight:700;
  border:1px solid var(--gb); background:var(--bg2); color:var(--t2);
  cursor:pointer; transition:all .15s; white-space:nowrap;
}
.filter-chip:hover { color:var(--text); }
.filter-chip.active { background:var(--gold); color:#000; border-color:var(--gold); }
.filter-chip.active-purple { background:rgba(192,132,252,.18); color:var(--purple); border-color:rgba(192,132,252,.35); }
.filter-chip.active-blue { background:rgba(79,195,247,.12); color:var(--blue); border-color:rgba(79,195,247,.3); }
.sort-select {
  background:var(--bg2); border:1px solid var(--gb); color:var(--t2);
  font-size:11px; font-weight:700; padding:5px 10px; border-radius:18px;
  outline:none; cursor:pointer; margin-left:auto;
}
.price-range { display:flex; align-items:center; gap:6px; }
.price-range input {
  width:70px; background:var(--bg2); border:1px solid var(--gb); color:var(--text);
  font-family:'DM Mono'; font-size:11px; padding:5px 8px; border-radius:18px;
  outline:none; text-align:center;
}
.price-range input:focus { border-color:var(--gold); }

/* Catalogue — grille */
.cat-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:10px; padding:14px 16px; }
.cat-card {
  background:var(--bg3); border:1.5px solid var(--gb);
  border-radius:var(--r); overflow:hidden; transition:border-color .15s;
}
.cat-card.active-card { border-color:var(--gold); background:var(--gdim); }
.cat-card-img {
  height:120px; background:var(--bg4); display:flex; align-items:center;
  justify-content:center; font-size:44px; position:relative; overflow:hidden;
}
.cat-card-img img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
.cat-card-img .emoji { position:relative; z-index:1; }
.cat-card-puffs {
  position:absolute; top:6px; left:6px; background:rgba(192,132,252,.2);
  border:1px solid rgba(192,132,252,.4); border-radius:5px;
  padding:2px 6px; font-size:9px; font-weight:700; color:var(--purple);
  font-family:'DM Mono'; z-index:2;
}
.cat-card-stock {
  position:absolute; top:6px; right:6px; border-radius:5px;
  padding:2px 6px; font-size:9px; font-weight:700; font-family:'DM Mono'; z-index:2;
}
.cat-card-stock.ok  { background:rgba(74,222,128,.2); color:var(--green); }
.cat-card-stock.low { background:rgba(251,146,60,.2); color:#FB923C; }
.cat-card-stock.out { background:rgba(248,113,113,.15); color:var(--red); }
.cat-card-body { padding:10px 12px; }
.cat-card-brand { font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--gold); margin-bottom:3px; }
.cat-card-name { font-size:12px; font-weight:700; line-height:1.3; margin-bottom:8px; }
.cat-card-price { font-size:16px; font-weight:800; margin-bottom:10px; }
.cat-card-footer { display:flex; align-items:center; gap:8px; }
.cat-card-footer .sw-label { font-size:11px; }

/* Image upload */
.img-pick {
  width:36px; height:36px; border-radius:7px; background:var(--bg3);
  border:1.5px dashed var(--gb); display:flex; align-items:center;
  justify-content:center; font-size:16px; cursor:pointer; flex-shrink:0;
  transition:border-color .15s;
}
.img-pick:hover { border-color:var(--gold); }
.img-thumb {
  width:36px; height:36px; border-radius:7px; object-fit:cover;
  border:1px solid var(--gb); cursor:pointer; flex-shrink:0;
}

/* Commandes */
.order-card {
  background:var(--bg3); border:1px solid var(--gb);
  border-radius:var(--r); padding:14px 16px; margin-bottom:10px;
  transition:border-color .15s;
}
.order-card:hover { border-color:rgba(255,255,255,.12); }
.order-header { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; margin-bottom:10px; }
.order-id { font-family:'DM Mono'; font-size:10px; color:var(--t3); }
.order-date { font-size:11px; color:var(--t3); margin-top:2px; }
.order-items { margin-bottom:10px; }
.order-item-row { display:flex; align-items:center; gap:8px; padding:5px 0; border-bottom:1px solid var(--gb2); }
.order-item-row:last-child { border:none; }
.order-item-name { font-size:13px; font-weight:700; flex:1; }
.order-item-qty { font-family:'DM Mono'; font-size:12px; color:var(--t2); }
.order-client { background:var(--bg2); border-radius:var(--rs); padding:10px 12px; margin-bottom:10px; font-size:12px; line-height:1.8; }
.order-client strong { color:var(--text); font-weight:700; }
.order-client .lbl { color:var(--t3); font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; }
.order-footer { display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; }
.order-amounts { display:flex; gap:16px; }
.order-amt { text-align:right; }
.order-amt .l { font-size:10px; color:var(--t3); }
.order-amt .v { font-size:15px; font-weight:800; }

/* Charts */
.chart-wrap { position:relative; height:220px; }
.chart-period-btns { display:flex; gap:6px; }
.period-btn {
  padding:4px 10px; border-radius:var(--rxs); font-size:11px; font-weight:700;
  border:1px solid var(--gb); background:var(--bg3); color:var(--t2); cursor:pointer;
}
.period-btn.active { background:var(--gdim); color:var(--gold); border-color:var(--gborder); }

/* Codes promo */
.promo-card {
  background:var(--bg3); border:1px solid var(--gb); border-radius:var(--r);
  padding:14px 16px; display:flex; align-items:center; gap:12px;
  margin-bottom:8px;
}
.promo-code {
  font-family:'DM Mono'; font-size:15px; font-weight:700; color:var(--gold);
  background:var(--gdim); border:1px solid var(--gborder); border-radius:var(--rxs);
  padding:4px 10px; flex-shrink:0;
}
.promo-info { flex:1; min-width:0; }
.promo-desc { font-size:12px; color:var(--t2); margin-top:3px; }
.promo-uses { font-family:'DM Mono'; font-size:11px; color:var(--t3); margin-top:2px; }

/* Retraits */
.wd-card {
  background:var(--bg3); border:1px solid var(--gb); border-radius:var(--r);
  padding:12px 14px; display:flex; align-items:center; gap:12px; margin-bottom:8px;
}
.wd-amount { font-size:18px; font-weight:800; color:var(--gold); flex-shrink:0; width:80px; }
.wd-info { flex:1; font-size:12px; color:var(--t2); }
.wd-date { font-size:10px; color:var(--t3); margin-top:2px; }

/* Form fields */
.form-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px; }
.form-row.full { grid-template-columns:1fr; }
.form-row.three { grid-template-columns:1fr 1fr 1fr; }
.fld-label { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--t3); margin-bottom:6px; display:block; }
.fld-input {
  width:100%; background:var(--bg3); border:1px solid var(--gb); color:var(--text);
  font-size:13px; padding:9px 12px; border-radius:var(--rs); outline:none; transition:border-color .15s;
}
.fld-input:focus { border-color:var(--gold); }
.fld-select {
  width:100%; background:var(--bg3); border:1px solid var(--gb); color:var(--text);
  font-size:13px; padding:9px 12px; border-radius:var(--rs); outline:none; cursor:pointer;
}

/* Toast */
.toast {
  position:fixed; bottom:20px; left:50%; transform:translateX(-50%) translateY(80px);
  background:var(--bg3); border:1px solid var(--gb); border-radius:10px;
  padding:10px 18px; font-size:12px; font-weight:700; z-index:999;
  transition:transform .3s cubic-bezier(.32,.72,0,1);
  box-shadow:0 8px 24px rgba(0,0,0,.5); pointer-events:none;
}
.toast.show { transform:translateX(-50%) translateY(0); }
.toast.ok   { border-color:var(--grbdr); color:var(--green); }
.toast.err  { border-color:var(--rbdr); color:var(--red); }

/* Empty state */
.empty-state {
  text-align:center; padding:48px 20px;
  display:flex; flex-direction:column; align-items:center; gap:12px;
}
.empty-icon { font-size:40px; opacity:.3; }
.empty-title { font-size:15px; font-weight:700; color:var(--t2); }
.empty-sub { font-size:12px; color:var(--t3); }

/* Divider */
.sep { height:1px; background:var(--gb); margin:12px 0; }

/* Grid 2 */
.g2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
@media(max-width:700px) { .g2 { grid-template-columns:1fr; } }
</style>
</head>
<body>

<!-- ═══════════════════════ LOGIN ═══════════════════════ -->
<div id="loginView">
  <div class="login-box">
    <div class="login-logo">🛍 <span>Vendor</span>OS</div>
    <div class="login-sub">Votre espace vendeur — entrez votre clé secrète pour accéder à votre dashboard.</div>
    <label class="login-label" for="secretInput">Clé secrète</label>
    <input class="login-input" type="password" id="secretInput" placeholder="••••••••••••••••••••••••••••••••" autocomplete="current-password">
    <button class="btn primary full" id="loginBtn" onclick="doLogin()">Accéder à mon dashboard →</button>
    <div class="login-err" id="loginErr"></div>
  </div>
</div>

<!-- ═══════════════════════ DASHBOARD ═══════════════════════ -->
<div id="dashView" style="display:none;flex:1;flex-direction:column;overflow:hidden;">
  <!-- TOPBAR -->
  <div class="topbar">
    <div class="topbar-logo">🛍 <span>Vendor</span>OS</div>
    <div class="topbar-nav">
      <div class="tnav active" id="nav-stock"     onclick="switchTab('stock')">📦 Stock</div>
      <div class="tnav"        id="nav-catalogue" onclick="switchTab('catalogue')">🛍 Catalogue</div>
      <div class="tnav"        id="nav-orders"    onclick="switchTab('orders')">📋 Commandes <span class="badge" id="newOrdersBadge" style="display:none;">0</span></div>
      <div class="tnav"        id="nav-stats"     onclick="switchTab('stats')">📊 Stats</div>
      <div class="tnav"        id="nav-promos"    onclick="switchTab('promos')">🏷 Promos</div>
      <div class="tnav"        id="nav-withdrawals" onclick="switchTab('withdrawals')">💸 Retraits</div>
    </div>
    <div class="topbar-right">
      <div class="seller-chip">
